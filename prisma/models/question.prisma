enum Category {
  JAVASCRIPT
  TYPESCRIPT
  NETWORK
  REACT
  REDUX
  REST
}

model Question {
  id        String   @id @default(uuid())
  text      String   @unique
  response  String?
  category  Category @default(REST)
  createdAt DateTime @default(now())

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  viewedBy UserQuestionView[]

  @@index([authorId])
  @@index([category])
  @@map("questions")
}
